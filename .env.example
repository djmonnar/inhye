# Supabase 프로젝트 설정 → API 에서 복사하세요.
# (Vercel 마켓플레이스에서 Supabase를 연결하면 자동으로 채워집니다)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 키 (관리자 계정 만들기 / 직원 계정 관리에 필요). 절대 NEXT_PUBLIC_ 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 아이디로 로그인할 때 내부적으로 붙는 이메일 도메인 (바꿀 필요 없음)
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=inhye.local
