# Supabase 프로젝트 설정 → API 에서 복사하세요.
# (Vercel 마켓플레이스에서 Supabase를 연결하면 자동으로 채워집니다)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 키 (관리자 계정 만들기 / 직원 계정 관리에 필요). 절대 NEXT_PUBLIC_ 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 사진으로 상품 정보 채우기. platform.openai.com → API keys 에서 발급 (서버 전용, NEXT_PUBLIC_ 금지)
OPENAI_API_KEY=
# (선택) 기본 gpt-6.1-terra. 더 싸게: gpt-6-luna / 더 똑똑하게: gpt-6.1-sol
OPENAI_MODEL=

# 아이디로 로그인할 때 내부적으로 붙는 이메일 도메인 (바꿀 필요 없음)
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=inhye.local

# 빅솔론 매장솔루션 연동 키 (서버 전용, NEXT_PUBLIC_ 붙이지 마세요)
BIXOLON_STORE_ID=
BIXOLON_API_KEY=
# (선택) 빅솔론 관리자 화면이 같이 보내는 값
BIXOLON_BRAND_ID=
BIXOLON_HQ_ID=
BIXOLON_AGENCY_ID=
# (선택) authorization 형식: 기본 Bearer, 키만 보내려면 none
BIXOLON_AUTH_SCHEME=
